rules_version = '2';

// Firestore security rules for the job toolkit web app.
// Paste these into Firebase Console → Firestore → Rules.
//
// Every document the app writes lives under users/{uid}/... and
// the rule below restricts read/write to the account that owns it.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
